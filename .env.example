# Copy to .env for local dev, or set these as Netlify environment variables.
# NEVER commit the real .env — it is gitignored.
# These are the SAME Autotask API credentials already used by autotask-report
# and daily-ticket-status — reuse them rather than creating a new API user.

AUTOTASK_USERNAME=your-api-user@example.com
AUTOTASK_SECRET=your-api-secret
AUTOTASK_INTEGRATION_CODE=your-api-tracking-identifier

# Nothing else needed server-side: Microsoft sign-in config (client ID,
# tenant ID) lives in public/config.js, not here — it's not a secret, MSAL
# SPA apps use PKCE with no client secret.
